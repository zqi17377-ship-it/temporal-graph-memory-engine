# Optional OpenAI API configuration for live LLM triple extraction & embeddings.
# Leave unset to run in 100% deterministic offline mode (scikit-learn TF-IDF+SVD + structured extractor).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Memory Engine Hyperparameters
WORKING_MEMORY_CAPACITY=6
WORKING_MEMORY_SALIENCE_THRESHOLD=0.35
EBBINGHAUS_DECAY_LAMBDA=0.016
EBBINGHAUS_REINFORCEMENT_ALPHA=1.8
CONSOLIDATION_THRESHOLD_THETA=0.25
